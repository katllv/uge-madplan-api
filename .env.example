# MySQL connection string for Prisma
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/katvudk_dihieu"

# Single shared password for the app
APP_PASSWORD="vælg-en-god-adgangskode"

# Secret used to sign JWT tokens — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="skift-dette-til-en-lang-tilfældig-streng"

# Port (optional — defaults to 3000)
PORT=3000
